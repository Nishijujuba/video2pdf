    {
      "suite_id": "project-scripts",
      "suite_key": "project-scripts",
      "roots": [
        {
          "path": "scripts",
          "pattern": "test_*.py"
        }
      ]
    },
    {
      "suite_id": "project-test-runner",
      "suite_key": "project-test-runner",
      "roots": [
        {
          "path": "tests/project_test_runner",
          "pattern": "test_*.py"
        }
      ]
    },
    {
      "suite_id": "skill-tests",
      "suite_key": "skill-tests",
      "roots": [
        {
          "path": ".agents/skills",
          "pattern": "**/test_*.py"
        }
      ]
    },
    {
      "suite_id": "video-workflow",
      "suite_key": "video-workflow",
