{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://video2pdf.local/schemas/delivery-quality/v1/acceptance-report-v2.v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema_name","schema_version","activation_status","execution_id","execution_revision","materialized_at","provider","input_binding_sha256","run_binding","skeleton_sha256","patches","criterion_results","precompile_owner_reports","visual_scan_evidence","cross_phase_findings","contract_gaps","overall_status","routing_state","repair_budget","repair_ledger_sha256","attempt_record_sha256","semantic_reinterpretation_performed","report_sha256"],
  "properties":{
    "schema_name":{"const":"acceptance-report-v2"},"schema_version":{"const":"2.0.0"},"activation_status":{"const":"target_only"},"execution_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"execution_revision":{"type":"integer","minimum":1},"materialized_at":{"type":"string","minLength":1},
    "provider":{"type":"object","additionalProperties":false,"required":["provider_id","provider_version"],"properties":{"provider_id":{"const":"acceptance-v2-provider"},"provider_version":{"const":"1.0.0"}}},
    "input_binding_sha256":{"$ref":"#/$defs/sha256"},"run_binding":{"$ref":"#/$defs/run_binding"},"skeleton_sha256":{"$ref":"#/$defs/sha256"},
    "patches":{"type":"object","additionalProperties":false,"required":["visual_quality"],"properties":{"visual_quality":{"type":"object","additionalProperties":false,"required":["patch_sha256","task_id","attempt_id"],"properties":{"patch_sha256":{"$ref":"#/$defs/sha256"},"task_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"attempt_id":{"type":"string","pattern":"^[0-9a-f]{32}$"}}}}},
    "criterion_results":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/rule_result"}},
    "precompile_owner_reports":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/owner_report"}},
    "visual_scan_evidence":{"type":"object","additionalProperties":false,"required":["pages_checked"],"properties":{"pages_checked":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/page_evidence"}}}},
    "cross_phase_findings":{"type":"array","items":{"$ref":"#/$defs/cross_phase_finding"}},"contract_gaps":{"type":"array","items":{"$ref":"#/$defs/contract_gap"}},
    "overall_status":{"enum":["pass","fail","blocked_contract_gap"]},"routing_state":{"enum":["ready_for_delivery","repair_required","manual_repair_required","human_disposition_required"]},
    "repair_budget":{"type":"object","additionalProperties":false,"required":["attempt_limit","semantic_attempts_used"],"properties":{"attempt_limit":{"const":3},"semantic_attempts_used":{"type":"integer","minimum":0,"maximum":3}}},
    "repair_ledger_sha256":{"$ref":"#/$defs/sha256"},"attempt_record_sha256":{"$ref":"#/$defs/sha256"},"semantic_reinterpretation_performed":{"const":false},"report_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "run_binding":{"type":"object","additionalProperties":false,"required":["run_id","coordination_revision","acceptance_revision","video_root","checkpoint","final_checkpoint","run_record_path","run_record_sha256","control_store_root","producer_ids","repairer_ids","predecessor_generation_set_sha256","changed_generation_ids"],"properties":{"run_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"coordination_revision":{"type":"integer","minimum":1},"acceptance_revision":{"type":"integer","minimum":1},"video_root":{"type":"string","minLength":1},"checkpoint":{"type":"object","additionalProperties":false,"required":["name","status","evidence_sha256"],"properties":{"name":{"const":"source_ready"},"status":{"const":"current"},"evidence_sha256":{"$ref":"#/$defs/sha256"}}},"final_checkpoint":{"type":"object","additionalProperties":false,"required":["name","status","authority_path","authority_sha256"],"properties":{"name":{"const":"final_quality_ready"},"status":{"const":"current"},"authority_path":{"type":"string","minLength":1},"authority_sha256":{"$ref":"#/$defs/sha256"}}},"run_record_path":{"type":"string","minLength":1},"run_record_sha256":{"$ref":"#/$defs/sha256"},"control_store_root":{"type":"string","minLength":1},"producer_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"repairer_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"predecessor_generation_set_sha256":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha256"}]},"changed_generation_ids":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "visual_evidence":{"type":"object","additionalProperties":false,"required":["artifact_logical_id","location"],"properties":{"artifact_logical_id":{"type":"string","minLength":1},"location":{"type":"string","minLength":1}}},
    "precompile_evidence":{"type":"object","additionalProperties":false,"required":["result_key","decision","evidence_locator","violation_id","repair_write_set"],"properties":{"result_key":{"type":"string","minLength":1},"decision":{"enum":["pass","fail"]},"evidence_locator":{"type":"string","minLength":1},"violation_id":{"type":["string","null"]},"repair_write_set":{"type":"array","items":{"type":"string"}}}},
    "rule_result":{"type":"object","additionalProperties":false,"required":["rule_id","rule_semantic_sha256","decision_phase","primary_semantic_decision_owner","source_report_sha256","artifact_generation_sha256","decision","evidence","violations","exceptions"],"properties":{"rule_id":{"type":"string","minLength":1},"rule_semantic_sha256":{"$ref":"#/$defs/sha256"},"decision_phase":{"enum":["precompile","postcompile"]},"primary_semantic_decision_owner":{"enum":["writing-quality-reviewer","visual-quality-reviewer"]},"source_patch_sha256":{"$ref":"#/$defs/sha256"},"source_report_sha256":{"$ref":"#/$defs/sha256"},"artifact_generation_sha256":{"$ref":"#/$defs/sha256"},"decision":{"enum":["pass","fail"]},"evidence":{"type":"array","minItems":1,"items":{"oneOf":[{"$ref":"#/$defs/visual_evidence"},{"$ref":"#/$defs/precompile_evidence"}]}},"violations":{"type":"array","items":{"type":"string"},"uniqueItems":true},"exceptions":{"type":"array","items":{"type":"string"},"uniqueItems":true},"cross_phase_finding_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "owner_report":{"type":"object","additionalProperties":false,"required":["owner","task_id","skeleton_sha256","patch_sha256","commit_sha256","reviewer","result_count","decision"],"properties":{"owner":{"enum":["source-faithfulness-reviewer","writing-quality-reviewer","pyramid-reviewer"]},"task_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"skeleton_sha256":{"$ref":"#/$defs/sha256"},"patch_sha256":{"$ref":"#/$defs/sha256"},"commit_sha256":{"$ref":"#/$defs/sha256"},"reviewer":{"type":"object","additionalProperties":false,"required":["reviewer_id","runtime_sha256","independent_from_generation_producers"],"properties":{"reviewer_id":{"type":"string"},"runtime_sha256":{"$ref":"#/$defs/sha256"},"independent_from_generation_producers":{"const":true}}},"result_count":{"type":"integer","minimum":1},"decision":{"enum":["pass","fail"]}}},
    "page_evidence":{"type":"object","additionalProperties":false,"required":["page","path","sha256","decision","evidence"],"properties":{"page":{"type":"integer","minimum":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"decision":{"enum":["pass","fail"]},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/visual_evidence"}}}},
    "cross_phase_finding":{"type":"object","additionalProperties":false,"required":["finding_id","rule_id","violation_id","effect","evidence"],"properties":{"finding_id":{"type":"string"},"rule_id":{"type":"string"},"violation_id":{"type":"string"},"effect":{"const":"add_failure_only"},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/visual_evidence"}}}},
    "contract_gap":{"type":"object","additionalProperties":false,"required":["gap_id","observation","evidence_location"],"properties":{"gap_id":{"type":"string"},"observation":{"type":"string"},"evidence_location":{"type":"string"}}}
  }
}
