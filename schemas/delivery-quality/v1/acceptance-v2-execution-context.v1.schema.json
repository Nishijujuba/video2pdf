{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://video2pdf.local/schemas/delivery-quality/v1/acceptance-v2-execution-context.v1.schema.json","type":"object","additionalProperties":false,"required":["schema_name","schema_version","activation_status","execution_id","execution_revision","state","prepared_at","attempt_number","input_binding_sha256","skeleton_sha256","committed_patches","report_publication","execution_sha256"],"properties":{"schema_name":{"const":"acceptance-v2-execution-context"},"schema_version":{"const":"1.0.0"},"activation_status":{"const":"target_only"},"execution_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"execution_revision":{"type":"integer","minimum":1},"state":{"enum":["reviewing","materialized","invalidated"]},"prepared_at":{"type":"string","minLength":1},"attempt_number":{"type":"integer","minimum":1,"maximum":3},"input_binding_sha256":{"$ref":"#/$defs/sha256"},"skeleton_sha256":{"$ref":"#/$defs/sha256"},"committed_patches":{"type":"object"},"report_publication":{"type":["object","null"]},"execution_sha256":{"$ref":"#/$defs/sha256"}},"$defs":{"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
