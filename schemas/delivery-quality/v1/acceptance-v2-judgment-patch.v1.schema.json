{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://video2pdf.local/schemas/delivery-quality/v1/acceptance-v2-judgment-patch.v1.schema.json","type":"object","additionalProperties":false,
  "required":["schema_name","schema_version","dimension","task_id","attempt_id","claim_generation","fencing_token","skeleton_sha256","reviewer","actual_read_set","criterion_results","visual_scan_evidence","cross_phase_findings","contract_gaps","patch_sha256"],
  "properties":{
    "schema_name":{"const":"acceptance-v2-judgment-patch"},"schema_version":{"const":"1.0.0"},"dimension":{"const":"visual_quality"},"task_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"attempt_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"claim_generation":{"const":1},"fencing_token":{"$ref":"#/$defs/sha256"},"skeleton_sha256":{"$ref":"#/$defs/sha256"},
    "reviewer":{"type":"object","additionalProperties":false,"required":["reviewer_id","independent"],"properties":{"reviewer_id":{"type":"string","minLength":1},"independent":{"const":true}}},
    "actual_read_set":{"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/read_binding"}},
    "criterion_results":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/criterion_result"}},
    "visual_scan_evidence":{"type":"object","additionalProperties":false,"required":["pages_checked"],"properties":{"pages_checked":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/page_evidence"}}}},
    "cross_phase_findings":{"type":"array","items":{"$ref":"#/$defs/cross_phase_finding"}},
    "contract_gaps":{"type":"array","items":{"$ref":"#/$defs/contract_gap"}},
    "patch_sha256":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "read_binding":{"type":"object","additionalProperties":false,"required":["logical_id","path","sha256"],"properties":{"logical_id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["artifact_logical_id","location"],"properties":{"artifact_logical_id":{"type":"string","minLength":1},"location":{"type":"string","minLength":1}}},
    "criterion_result":{"type":"object","additionalProperties":false,"required":["criterion_id","decision","evidence","violation_id","required_change","allowed_repair_types"],"properties":{"criterion_id":{"type":"string","minLength":1},"decision":{"enum":["pass","fail"]},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},"violation_id":{"type":["string","null"]},"required_change":{"type":["string","null"]},"allowed_repair_types":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
    "page_evidence":{"type":"object","additionalProperties":false,"required":["page","path","sha256","decision","evidence"],"properties":{"page":{"type":"integer","minimum":1},"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"},"decision":{"enum":["pass","fail"]},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}}}},
    "cross_phase_finding":{"type":"object","additionalProperties":false,"required":["finding_id","rule_id","violation_id","effect","evidence"],"properties":{"finding_id":{"type":"string","minLength":1},"rule_id":{"type":"string","minLength":1},"violation_id":{"type":"string","minLength":1},"effect":{"const":"add_failure_only"},"evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}}}},
    "contract_gap":{"type":"object","additionalProperties":false,"required":["gap_id","observation","evidence_location"],"properties":{"gap_id":{"type":"string","minLength":1},"observation":{"type":"string","minLength":1},"evidence_location":{"type":"string","minLength":1}}}
  }
}
