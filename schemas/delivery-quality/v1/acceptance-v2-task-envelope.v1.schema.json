{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/acceptance-v2-task-envelope.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "activation_status", "task_authority", "dimension", "task_id", "attempt_id", "expected_execution_revision", "coordinator_session", "claim_generation", "fencing_token", "criterion_ids", "authorized_read_set", "input_access", "declared_write_set", "required_output", "peer_results_visible", "skeleton_sha256"],
  "properties": {
    "schema_name": {"const": "acceptance-v2-task-envelope"},
    "schema_version": {"const": "1.0.0"},
    "activation_status": {"enum": ["target_only", "active_global_gate"]},
    "task_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "execution_id"],
      "properties": {
        "kind": {"const": "acceptance_execution"},
        "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
      }
    },
    "dimension": {"const": "visual_quality"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "expected_execution_revision": {"const": 1},
    "coordinator_session": {"type": "string", "minLength": 1},
    "claim_generation": {"const": 1},
    "fencing_token": {"$ref": "#/$defs/sha256"},
    "criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authorized_read_set": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/read_binding"}},
    "input_access": {"const": "read_only"},
    "declared_write_set": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/write_binding"}},
    "required_output": {"$ref": "#/$defs/required_output"},
    "peer_results_visible": {"const": false},
    "skeleton_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "read_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "path", "sha256"],
      "properties": {
        "logical_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "write_binding": {"type": "object", "additionalProperties": false, "required": ["logical_id", "path"], "properties": {"logical_id": {"const": "judgment_patch"}, "path": {"type": "string", "minLength": 1}}},
    "required_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_id", "path", "contract"],
      "properties": {
        "logical_id": {"const": "judgment_patch"},
        "path": {"type": "string", "minLength": 1},
        "contract": {"$ref": "#/$defs/output_contract"}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "field_ownership", "serialization", "fingerprint"],
      "properties": {
        "schema": {"$ref": "#/$defs/output_schema"},
        "field_ownership": {"$ref": "#/$defs/field_ownership"},
        "serialization": {"$ref": "#/$defs/serialization"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "sha256"],
      "properties": {
        "name": {"const": "acceptance-v2-judgment-patch"},
        "version": {"const": "1.0.0"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "field_ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_bound", "reviewer_judgment", "mechanically_derived", "optional", "forbidden"],
      "properties": {
        "provider_bound": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reviewer_judgment": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mechanically_derived": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional": {"type": "array", "maxItems": 0},
        "forbidden": {"const": "all_fields_not_declared_by_schema"}
      }
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "ensure_ascii", "sort_keys", "item_separator", "key_separator", "trailing_newline"],
      "properties": {
        "encoding": {"const": "utf-8"},
        "ensure_ascii": {"const": false},
        "sort_keys": {"const": true},
        "item_separator": {"const": ","},
        "key_separator": {"const": ":"},
        "trailing_newline": {"const": "required"}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "field", "algorithm", "input"],
      "properties": {
        "owner": {"const": "acceptance_v2_provider"},
        "field": {"const": "patch_sha256"},
        "algorithm": {"const": "sha256"},
        "input": {"const": "canonical_json_without_patch_sha256"}
      }
    }
  }
}
