{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/delivery-quality-language-profiles.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "profile_registry_version", "profiles"],
  "properties": {
    "schema_name": {"const": "delivery-quality-language-profiles"},
    "schema_version": {"const": "1.0.0"},
    "profile_registry_version": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "semantic_sha256", "primary_language", "permitted_supporting_languages", "reader_contract", "terminology_policy"],
        "properties": {
          "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
          "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "primary_language": {"enum": ["zh-Hans", "en"]},
          "permitted_supporting_languages": {"type": "array", "uniqueItems": true, "items": {"enum": ["zh-Hans", "en"]}},
          "reader_contract": {"type": "string", "minLength": 1},
          "terminology_policy": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
