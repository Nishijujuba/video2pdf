{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/delivery-quality-migration-ledger.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "ledger_version", "activation_status", "source_contract", "entries"],
  "properties": {
    "schema_name": {"const": "delivery-quality-migration-ledger"},
    "schema_version": {"const": "1.0.0"},
    "ledger_version": {"const": "1.0.0"},
    "activation_status": {"const": "target_only"},
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "1.0"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_criterion_id", "rule_id", "decision_phase", "primary_semantic_decision_owner", "migration_kind", "meaning_preserved", "notes"],
        "properties": {
          "source_criterion_id": {"type": "string", "minLength": 1},
          "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
          "decision_phase": {"enum": ["precompile", "postcompile"]},
          "primary_semantic_decision_owner": {"type": "string", "pattern": "^[a-z][a-z0-9._-]+$"},
          "migration_kind": {"enum": ["identity", "split"]},
          "meaning_preserved": {"const": true},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
