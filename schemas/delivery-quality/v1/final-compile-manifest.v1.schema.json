{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/final-compile-manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "activation_status", "mode", "precompile_text_seal_sha256", "entries", "approved_runtime_inputs", "runtime_policy", "manifest_sha256"],
  "properties": {
    "schema_name": {"const": "final-compile-manifest"},
    "schema_version": {"const": "1.0.0"},
    "activation_status": {"const": "target_only"},
    "mode": {"const": "final"},
    "precompile_text_seal_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["logical_id", "generation", "sha256", "source_path", "staging_path"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "source_path": {"type": "string", "minLength": 1}, "staging_path": {"type": "string", "minLength": 1}}}},
    "approved_runtime_inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "classification"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "classification": {"enum": ["registered_runtime_dependency", "registered_system_font"]}}}},
    "runtime_policy": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
