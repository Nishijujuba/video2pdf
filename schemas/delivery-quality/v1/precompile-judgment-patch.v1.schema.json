{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/precompile-judgment-patch.v1.schema.json",
  "type": "object",
  "required": ["schema_name", "schema_version", "task_id", "owner", "skeleton_sha256", "generation_set_sha256", "reviewer", "results", "contract_gaps", "patch_sha256"],
  "properties": {
    "schema_name": {"const": "precompile-judgment-patch"},
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "owner": {"enum": ["source-faithfulness-reviewer", "writing-quality-reviewer", "pyramid-reviewer"]},
    "skeleton_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {"type": "object"},
    "results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "contract_gaps": {"type": "array", "items": {"type": "object"}},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
