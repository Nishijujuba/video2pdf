{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/render-evidence-manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "activation_status", "final_pdf_sha256", "page_count", "pages", "manifest_sha256"],
  "properties": {
    "schema_name": {"const": "render-evidence-manifest"},
    "schema_version": {"const": "1.0.0"},
    "activation_status": {"const": "target_only"},
    "final_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "page_count": {"type": "integer", "minimum": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page", "path", "sha256"], "properties": {"page": {"type": "integer", "minimum": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
