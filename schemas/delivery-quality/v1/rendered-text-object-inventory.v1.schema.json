{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/rendered-text-object-inventory.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "activation_status", "final_pdf_sha256", "extractor_suite", "coverage", "objects", "inventory_sha256"],
  "properties": {
    "schema_name": {"const": "rendered-text-object-inventory"},
    "schema_version": {"const": "1.0.0"},
    "activation_status": {"const": "target_only"},
    "final_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "extractor_suite": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["extractor_id", "extractor_sha256"], "properties": {"extractor_id": {"type": "string", "minLength": 1}, "extractor_sha256": {"$ref": "#/$defs/sha256"}}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["page_count", "pages_scanned", "content_streams_complete", "annotations_complete", "form_xobjects_complete", "declared_raster_text_complete"], "properties": {"page_count": {"type": "integer", "minimum": 1}, "pages_scanned": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}, "content_streams_complete": {"type": "boolean"}, "annotations_complete": {"type": "boolean"}, "form_xobjects_complete": {"type": "boolean"}, "declared_raster_text_complete": {"type": "boolean"}}},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["object_id", "page", "object_kind", "bbox", "exact_utf8_text", "text_sha256", "extractor_id", "evidence_locator", "object_sha256"], "properties": {"object_id": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}, "object_kind": {"type": "string", "minLength": 1}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}, "exact_utf8_text": {"type": "string"}, "text_sha256": {"$ref": "#/$defs/sha256"}, "extractor_id": {"type": "string", "minLength": 1}, "evidence_locator": {"type": "string", "minLength": 1}, "object_sha256": {"$ref": "#/$defs/sha256"}}}},
    "inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
