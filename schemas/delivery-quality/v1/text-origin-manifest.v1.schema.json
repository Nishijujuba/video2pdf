{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/delivery-quality/v1/text-origin-manifest.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "activation_status", "compiler_provider", "precompile_text_seal_sha256", "final_artifact_seal_sha256", "rendered_text_inventory_sha256", "edges", "manifest_sha256"],
  "properties": {
    "schema_name": {"const": "text-origin-manifest"},
    "schema_version": {"const": "1.0.0"},
    "activation_status": {"const": "target_only"},
    "compiler_provider": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_sha256"], "properties": {"provider_id": {"type": "string", "minLength": 1}, "provider_sha256": {"$ref": "#/$defs/sha256"}}},
    "precompile_text_seal_sha256": {"$ref": "#/$defs/sha256"},
    "final_artifact_seal_sha256": {"$ref": "#/$defs/sha256"},
    "rendered_text_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["edge_id", "disposition", "rendered_object_ids", "recipe"], "properties": {"edge_id": {"type": "string", "minLength": 1}, "disposition": {"type": "string", "minLength": 1}, "sealed_item_id": {"type": "string", "minLength": 1}, "sealed_text_utf8": {"type": "string"}, "rendered_object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "recipe": {"type": "string", "minLength": 1}, "source_mapping": {"$ref": "#/$defs/sourceMapping"}, "generator": {"type": "object", "additionalProperties": false, "required": ["generator_id", "generator_version", "generator_sha256", "kind", "inputs"], "properties": {"generator_id": {"type": "string", "minLength": 1}, "generator_version": {"type": "string", "minLength": 1}, "generator_sha256": {"$ref": "#/$defs/sha256"}, "kind": {"type": "string", "minLength": 1}, "inputs": {"type": "object"}, "source_mapping": {"type": "object"}}}}}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "sourceMapping": {"type": "object", "additionalProperties": false, "required": ["logical_id", "generation", "sha256", "method", "provider", "object_sources"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "method": {"const": "compiler_synctex_v1"}, "provider": {"type": "object"}, "object_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}}}}}
}
