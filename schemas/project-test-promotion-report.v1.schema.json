{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nishijujuba/video2pdf/schemas/project-test-promotion-report.v1.schema.json",
  "title": "Project Test Runner Promotion Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "issue",
    "historical_performance_baseline",
    "final_issue9_closed_set",
    "implementation",
    "promotion_closed_set",
    "parallel_runs",
    "semantic_parity",
    "migration_review",
    "performance",
    "promotion_fingerprint",
    "cutover_authorized"
  ],
  "properties": {
    "schema_name": {
      "const": "video2pdf.project-test-promotion-report"
    },
    "schema_version": {
      "const": 1
    },
    "issue": {
      "const": 27
    },
    "historical_performance_baseline": {
      "$ref": "#/$defs/historicalBaseline"
    },
    "final_issue9_closed_set": {
      "$ref": "#/$defs/closedSet"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "promotion_closed_set": {
      "$ref": "#/$defs/promotionClosedSet"
    },
    "parallel_runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/parallelRun"
      }
    },
    "semantic_parity": {
      "$ref": "#/$defs/semanticParity"
    },
    "migration_review": {
      "$ref": "#/$defs/reviewBinding"
    },
    "performance": {
      "$ref": "#/$defs/performance"
    },
    "promotion_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "cutover_authorized": {
      "const": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "historicalBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_commit",
        "test_count",
        "result",
        "test_duration_seconds",
        "persisted_elapsed_seconds"
        ,
        "persisted_run_dir",
        "persisted_status_path",
        "persisted_status_sha256",
        "persisted_exit_code_path",
        "persisted_exit_code_sha256"
      ],
      "properties": {
        "implementation_commit": {
          "const": "18f78fad0be5a66d2da6250dc268bc8de81fdbcc"
        },
        "test_count": {
          "const": 474
        },
        "result": {
          "const": "OK"
        },
        "test_duration_seconds": {
          "const": 4847.218
        },
        "persisted_elapsed_seconds": {
          "const": 4849.187
        },
        "persisted_run_dir": {
          "type": "string",
          "minLength": 1
        },
        "persisted_status_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_status_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "persisted_exit_code_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_exit_code_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "closedSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "test_count",
        "test_id_set_sha256",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "test_count": {
          "type": "integer",
          "minimum": 1
        },
        "test_id_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "promotionClosedSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_ids", "test_count", "test_id_set_sha256"],
      "properties": {
        "suite_ids": {
          "const": ["video-workflow"]
        },
        "test_count": {
          "type": "integer",
          "minimum": 1
        },
        "test_id_set_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parallelRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_dir",
        "discovery_path",
        "discovery_sha256",
        "summary_path",
        "summary_sha256",
        "persisted_run_dir",
        "persisted_status_path",
        "persisted_status_sha256",
        "persisted_exit_code_path",
        "persisted_exit_code_sha256",
        "persisted_command_path",
        "persisted_command_sha256",
        "persisted_stdout_path",
        "persisted_stdout_sha256"
      ],
      "properties": {
        "run_dir": {
          "type": "string",
          "minLength": 1
        },
        "discovery_path": {
          "type": "string",
          "minLength": 1
        },
        "discovery_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary_path": {
          "type": "string",
          "minLength": 1
        },
        "summary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "persisted_run_dir": {
          "type": "string",
          "minLength": 1
        },
        "persisted_status_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_status_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "persisted_exit_code_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_exit_code_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "persisted_command_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_command_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "persisted_stdout_path": {
          "type": "string",
          "minLength": 1
        },
        "persisted_stdout_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "semanticParity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "test_id_set_sha256", "ignored_fields"],
      "properties": {
        "passed": {
          "const": true
        },
        "test_id_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ignored_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "timestamps",
              "pids",
              "durations",
              "completion_order"
            ]
          }
        }
      }
    },
    "reviewBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "passed"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "passed": {
          "const": true
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_elapsed_seconds", "passed"],
      "properties": {
        "maximum_elapsed_seconds": {
          "const": 1800
        },
        "passed": {
          "const": true
        }
      }
    }
  }
}
