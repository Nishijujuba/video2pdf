{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/video-workflow/v1/control-store-reinitialization-sentinel.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "kernel_version", "operation_id",
    "operation", "state", "coordinator_session_id", "created_at",
    "snapshot_path", "store_id",
    "proposed_replacement_epoch"
  ],
  "properties": {
    "schema_name": {"const": "control-store-reinitialization-sentinel"},
    "schema_version": {"const": "1.0.0"},
    "kernel_version": {"const": "2.0.0"},
    "operation_id": {"type": "string", "pattern": "^reinitialize-[0-9a-f]{32}$"},
    "operation": {"const": "reinitialization"},
    "state": {"enum": ["PREPARING", "ELIGIBILITY_PUBLISHED", "BLOCKED"]},
    "coordinator_session_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "snapshot_path": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/absolute_path"},
    "snapshot_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
    "store_id": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
    "proposed_replacement_epoch": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"state": {"const": "ELIGIBILITY_PUBLISHED"}},
        "required": ["state"]
      },
      "then": {"required": ["snapshot_sha256"]}
    }
  ]
}
