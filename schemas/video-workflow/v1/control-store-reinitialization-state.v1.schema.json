{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/video-workflow/v1/control-store-reinitialization-state.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "kernel_version", "operation_id",
    "snapshot_path", "snapshot_sha256", "coordinator_session_id",
    "replacement_store_epoch", "candidate_root", "prior_root", "state",
    "state_history"
  ],
  "properties": {
    "schema_name": {"const": "control-store-reinitialization-state"},
    "schema_version": {"const": "1.0.0"},
    "kernel_version": {"const": "2.0.0"},
    "operation_id": {"type": "string", "pattern": "^reinitialize-[0-9a-f]{32}$"},
    "snapshot_path": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/absolute_path"},
    "snapshot_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
    "coordinator_session_id": {"type": "string", "minLength": 1},
    "replacement_store_epoch": {"type": "integer", "minimum": 1},
    "candidate_root": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/absolute_path"},
    "prior_root": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/absolute_path"},
    "state": {"enum": ["PREPARED", "OLD_MOVED", "NEW_PUBLISHED", "RECONCILING", "COMMITTED", "BLOCKED"]},
    "blocked_from_state": {"enum": ["PREPARED", "OLD_MOVED", "NEW_PUBLISHED", "RECONCILING"]},
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "recorded_at"],
        "properties": {
          "state": {"enum": ["PREPARED", "OLD_MOVED", "NEW_PUBLISHED", "RECONCILING", "COMMITTED", "BLOCKED"]},
          "recorded_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "BLOCKED"}}, "required": ["state"]},
      "then": {"required": ["blocked_from_state"]}
    }
  ]
}
