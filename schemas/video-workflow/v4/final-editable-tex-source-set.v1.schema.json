{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/video-workflow/v4/final-editable-tex-source-set.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "kernel_version", "project_root", "generation_set_sha256", "final_pdf", "compile_evidence", "members", "source_set_sha256"],
  "properties": {
    "schema_name": {"const": "final-editable-tex-source-set"},
    "schema_version": {"const": "1.0.0"},
    "kernel_version": {"const": "2.0.0"},
    "project_root": {"type": "string", "minLength": 1},
    "generation_set_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
    "final_pdf": {"$ref": "#/$defs/file"},
    "compile_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["compile_manifest_sha256", "recorder_path", "recorder_sha256", "dependency_closure_complete", "final_pdf", "tex_entrypoint_logical_id", "consumed_project_tex_sources"],
      "properties": {
        "compile_manifest_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
        "recorder_path": {"type": "string", "minLength": 1},
        "recorder_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
        "dependency_closure_complete": {"const": true},
        "final_pdf": {"$ref": "#/$defs/file"},
        "tex_entrypoint_logical_id": {"type": "string", "minLength": 1},
        "consumed_project_tex_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "source_set_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}, "size": {"type": "integer", "minimum": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["logical_id", "generation", "path", "sha256", "size"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["logical_id", "generation", "path", "sha256", "size", "role"], "properties": {"logical_id": {"type": "string", "minLength": 1}, "generation": {"type": "integer", "minimum": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}, "size": {"type": "integer", "minimum": 0}, "role": {"enum": ["tex_entrypoint", "included_tex_source"]}}}
  }
}
