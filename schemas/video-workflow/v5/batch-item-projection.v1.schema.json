{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video2pdf.local/schemas/video-workflow/v5/batch-item-projection.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "kernel_version",
    "batch_id",
    "item_index",
    "run_id",
    "run_state",
    "checkpoint",
    "blocker",
    "delivery_outcome",
    "projection_revision",
    "projected_at",
    "source_authority"
  ],
  "properties": {
    "schema_name": {"const": "batch-item-projection"},
    "schema_version": {"const": "1.0.0"},
    "kernel_version": {"const": "2.0.0"},
    "batch_id": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/run_id"},
    "item_index": {"type": "integer", "minimum": 1},
    "run_id": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/run_id"},
    "run_state": {"$ref": "#/$defs/runState"},
    "checkpoint": {"$ref": "#/$defs/checkpoint"},
    "blocker": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "delivery_outcome": {"$ref": "#/$defs/deliveryOutcome"},
    "projection_revision": {"type": "integer", "minimum": 1},
    "projected_at": {"type": "string", "format": "date-time"},
    "source_authority": {"$ref": "#/$defs/sourceAuthority"}
  },
  "$defs": {
    "runState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "source_state", "source_blocker", "coordination_revision", "output_path", "delivery"],
      "properties": {
        "phase": {"enum": ["source_acquisition", "source_ready"]},
        "source_state": {"enum": ["pending", "blocked_user_input", "candidates_ready", "decision_ready", "ready", "stale"]},
        "source_blocker": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "coordination_revision": {"type": "integer", "minimum": 1},
        "output_path": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/absolute_path"},
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "ownership"],
          "properties": {
            "stage": {"enum": ["generating", "ready_for_delivery", "accepted", "delivered", "blocked"]},
            "ownership": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session_id", "generation"],
              "properties": {
                "session_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "generation": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "stale"]}
      }
    },
    "deliveryOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_stage", "guarded_delivered", "acceptance_report_sha256", "guard_report_sha256", "delivered_at"],
      "properties": {
        "delivery_stage": {"enum": ["generating", "ready_for_delivery", "accepted", "delivered", "blocked"]},
        "guarded_delivered": {"type": "boolean"},
        "acceptance_report_sha256": {"anyOf": [{"type": "null"}, {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}]},
        "guard_report_sha256": {"anyOf": [{"type": "null"}, {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}]},
        "delivered_at": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_record_sha256", "guard_report_sha256", "accepted_at_projection"],
      "properties": {
        "run_record_sha256": {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"},
        "guard_report_sha256": {"anyOf": [{"type": "null"}, {"$ref": "https://video2pdf.local/schemas/video-workflow/v1/common.v1.schema.json#/$defs/sha256"}]},
        "accepted_at_projection": {"type": "string", "format": "date-time"}
      }
    }
  }
}
